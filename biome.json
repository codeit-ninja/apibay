{
    "$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4
    },
    "linter": {
        "enabled": false
    },
    "assist": {
        "enabled": false
    },
    "files": {
        "includes": [
            "src/**/*.ts",
            "**/*.ts",
            "src/**/*.json",
            "**/*.json",
            "*.json",
            "*.ts"
        ]
    }
}
